# Copy to .env. Every variable is optional.

# Required in the X-Scan-Password header (the password field in the UI). Empty = no password.
SCAN_PASSWORD=

# Host port the container listens on (bound to 127.0.0.1; put a reverse proxy in front).
PORT=8000

# Shown in PDF reports. SITE_NAME also adds a link to /metodologi.
BRAND_NAME=SecScan PQC
SITE_NAME=

# Scan limits.
MAX_CONCURRENT_HOSTS=4
RATE_LIMIT_HOSTS=40
